exports[`cada tipo de ação em cada cenário > enviar_analise_credito 1`] = `
{
  "com_tarefas": {
    "chamadas": [
      "from(leads).select("id, nome, corretor_id, status, cadencia_etapa, objecoes, renda_informada, renda_estimada, entrada_disponivel, usa_fgts, tem_fgts, fgts_valor, tipo_renda, faixa_mcmv, temperatura, decisor, zona, bairro, dorms_desejados, precisa_vaga, prioridades, nota_perfil_cliente, projeto_id, projeto_nome, construtora, resumo_qualificacao").eq("id","11111111-1111-4111-8111-111111111111").is("deleted_at",null).maybeSingle()",
      "rpc(transicionar_lead,{"p_lead_id":"11111111-1111-4111-8111-111111111111","p_novo_status":"analise_credito","p_motivo":"Análise de crédito — Enviada ao banco","p_proxima_acao":"Cobrar retorno do crédito de Lucas Ferreira","p_proximo_followup":"2026-10-27T13:00:00.000Z"})",
      "from(analises_credito).insert({"lead_id":"11111111-1111-4111-8111-111111111111","corretor_id":"u1","status":"enviada","observacoes":"Caixa"}).select("id").single()",
      "from(interacoes).insert({"lead_id":"11111111-1111-4111-8111-111111111111","autor_id":"u1","tipo":"nota","direcao":"interna","titulo":"Análise de crédito — Enviada ao banco","conteudo":"Caixa","metadata":{"status_analise":"enviada","origem":"samiq","proposta_id":"prop-1","execution_id":"exec-1"}}).select("id").single()",
      "from(tarefas).select("id, titulo, tipo, prioridade, data_vencimento").eq("lead_id","11111111-1111-4111-8111-111111111111").in("status",["pendente","em_andamento"]).is("deleted_at",null).gte("data_vencimento","2026-10-27T11:00:00.000Z").lte("data_vencimento","2026-10-27T15:00:00.000Z").limit(10)",
      "from(tarefas).select("id, titulo, tipo, prioridade, data_vencimento").eq("lead_id","11111111-1111-4111-8111-111111111111").eq("tipo","follow_up").in("status",["pendente","em_andamento"]).is("deleted_at",null).gte("data_vencimento","2026-10-26T13:00:00.000Z").lte("data_vencimento","2026-10-28T13:00:00.000Z").limit(1)",
      "from(tarefas).update({"titulo":"Cobrar retorno do crédito de Lucas Ferreira","prioridade":"media","data_vencimento":"2026-10-27T13:00:00.000Z"}).eq("id","33333333-3333-4333-8333-333333333333")",
      "from(tarefas).select("status, data_vencimento").eq("id","33333333-3333-4333-8333-333333333333").maybeSingle()",
